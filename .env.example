# ============================================================================
# Mosaico Angola — Ficheiro de Exemplo de Variáveis de Ambiente
# Revista Oficial & Portal Diplomático da Embaixada de Angola em Espanha e Andorra
# ============================================================================

# GEMINI_API_KEY: Necessário para funcionalidades alimentadas por IA (se aplicável).
GEMINI_API_KEY=""

# APP_URL: URL de alojamento da aplicação (ex: https://mosaico.ao)
APP_URL=""

# --- Supabase (Base de Dados PostgreSQL e Autenticação de Operadores) ---
# O prefixo VITE_ é obrigatório para que o Vite inclua estas variáveis no cliente web.
# NUNCA inclua a Service Role Key (chave de administrador secreta) no frontend.
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-do-supabase"
